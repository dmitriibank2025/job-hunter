DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/job_hunter?schema=public"
PORT=4000
NODE_ENV=development
SERVE_FRONTEND=false
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost:4000
JOB_HUNTER_API_BASE_URL=http://localhost:4000
STORAGE_DIR=storage

JOB_SEARCH_KEYWORDS=full stack developer,backend developer,node.js typescript,react node.js aws
JOB_SEARCH_LOCATION=Israel
LINKEDIN_SEARCH_URLS=https://www.linkedin.com/jobs/search/?currentJobId=4419299075&distance=25&f_TPR=r86400&geoId=101620260&keywords=Full%20Stack&origin=JOB_SEARCH_PAGE_JOB_FILTER&refresh=true,https://www.linkedin.com/jobs/search/?distance=25&f_TPR=r86400&geoId=101620260&keywords=Backend%20Developer&origin=JOB_SEARCH_PAGE_JOB_FILTER&refresh=true
LINKEDIN_STORAGE_STATE=storage/linkedin_auth.json
LINKEDIN_RECOMMENDED_OUTPUT=storage/linkedin_recommended_jobs.json
LINKEDIN_HEADLESS=true
LINKEDIN_CONNECT_HEADLESS=false
LINKEDIN_CONNECT_BROWSER_CHANNEL=chrome
LINKEDIN_AUTH_TIMEOUT_MS=300000
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
PROVIDER_BROWSER_TIMEOUT_MS=120000
PROVIDER_PAGE_TIMEOUT_MS=20000
PROVIDER_TIMEOUT_MS=150000
LINKEDIN_PROVIDER_TIMEOUT_MS=900000
PROVIDER_FETCH_DETAILS=false
ACTIVE_PROVIDERS=LINKEDIN,GREENHOUSE,GLASSDOOR

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
JOB_REPORT_CRON="0 9 * * *"
DAILY_JOB_CHECK_CRON="* * * * *"
JOB_REPORT_TIMEZONE=Asia/Jerusalem
DAILY_JOB_REPORT_ENABLED=true
DAILY_FRESH_JOB_RANGE_DAYS=1
DAILY_LINKEDIN_GLOBAL_FALLBACK=true

EMAIL_REPORT_ENABLED=true

GLASSDOOR_SEARCH_URLS=https://www.glassdoor.com/Job/israel-full-stack-jobs-SRCH_IL.0,6_IN119_KO7,17.htm?fromAge=1;https://www.glassdoor.com/Job/israel-backend-jobs-SRCH_IL.0,6_IN119_KO7,14.htm?fromAge=1
ALLJOBS_SEARCH_URLS=https://www.alljobs.co.il/SearchResultsGuest.aspx?page=1&position=&type=&freetxt=full%20stack%20developer&city=779&region=,https://www.alljobs.co.il/SearchResultsGuest.aspx?page=1&position=&type=&freetxt=backend%20developer&city=779&region=,https://www.alljobs.co.il/SearchResultsGuest.aspx?page=1&position=&type=&freetxt=node.js%20developer&city=779&region=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_ID=me
GMAIL_REDIRECT_URI=http://localhost:4000/oauth/google/callback

OPENAI_API_KEY=
MIN_MATCH_SCORE=70
ATS_RESUME_MIN_SCORE=75
# Comma-separated keywords to exclude jobs from automation (e.g. Java,Golang,mobile,.NET,Salesforce)
JOB_SEARCH_EXCLUDED_KEYWORDS=
ATS_RESUME_ENFORCE=false
