{
  "name": "job-hunter-backend",
  "version": "1.0.0",
  "description": "Job Hunter backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "gmail:auth-url": "tsx src/scripts/gmail-oauth.ts auth-url",
    "gmail:exchange-code": "tsx src/scripts/gmail-oauth.ts exchange-code",
    "glassdoor:auth": "tsx src/scripts/glassdoor-oauth.ts login",
    "migrate:resume-folders": "tsx src/scripts/migrate-resumes-to-user-folders.ts",
    "linkedin:auth": "tsx src/scripts/linkedin-recommended.ts auth",
    "linkedin:recommended": "tsx src/scripts/linkedin-recommended.ts extract",
    "postinstall": "prisma generate",
    "prisma:generate": "dotenv -e ../.env -- prisma generate",
    "prisma:migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e ../.env -- prisma studio",
    "test": "pnpm run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1063.0",
    "@aws-sdk/client-dynamodb": "^3.1063.0",
    "@aws-sdk/client-sqs": "^3.1063.0",
    "@aws-sdk/credential-providers": "^3.1063.0",
    "@aws-sdk/lib-dynamodb": "^3.1063.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "docx-templates": "^4.15.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "morgan": "^1.11.0",
    "node-cron": "^4.2.1",
    "openai": "^6.41.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.60.0",
    "stripe": "^22.2.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}
