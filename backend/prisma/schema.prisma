// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ResumeBaseTarget {
  FRONTEND
  BACKEND
  FULLSTACK
  CUSTOM
}

enum UsageEventType {
  VACANCY_COLLECTED
  RESUME_GENERATED
  COVER_LETTER_GENERATED
  OPENAI_TOKENS
  SEARCH_RUN
}

model AppUser {
  id           String             @id @default(uuid())
  email        String             @unique
  role         UserRole           @default(USER)
  plan         SubscriptionPlan   @default(FREE)
  status       SubscriptionStatus @default(ACTIVE)
  passwordHash String?
  dailyAutomationEnabled Boolean @default(false)
  dailyAutomationTime    String  @default("09:00")
  dailyAutomationTimezone String @default("Asia/Jerusalem")
  dailyAutomationLastRunKey String?
  dailyAutomationFullstackResumeBaseId String?
  dailyAutomationBackendResumeBaseId   String?
  dailyAutomationFrontendResumeBaseId  String?
  searchExcludeRemote    Boolean @default(false)

  profile               UserProfile?
  blacklistedCompanies  UserBlacklistedCompany[]
  technologies          UserTechnology[]
  experiences           UserExperience[]
  educations            UserEducation[]
  resumeBases           UserResumeBase[]
  linkedinAccounts      UserLinkedInAccount[]
  usageEvents           UserUsageEvent[]
  generatedResumes      ResumeVersion[]
  generatedCoverLetters CoverLetter[]
  refreshTokens         AuthRefreshToken[]
  jobMatches            UserJobMatch[]
  applications          Application[]
  emailEvents           EmailEvent[]
  gmailAccounts         UserGmailAccount[]
  appliedVacancies      AppliedVacancy[]
  rejectionRecords      RejectionRecord[]
  promptRules           PromptRule[]
  telegramConnectSessions TelegramConnectSession[]
  experienceChunks      ExperienceChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plan, status])
  @@index([createdAt])
}

/// Candidate experience corpus for RAG grounding + the agent's search_experience tool.
/// `embedding` is a pgvector column (text-embedding-3-small, 1536 dims); queried via
/// raw SQL cosine distance (`<=>`), so it is typed Unsupported for Prisma.
model ExperienceChunk {
  id        String                       @id @default(uuid())
  userId    String
  user      AppUser                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String
  text      String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())

  @@index([userId])
}

model UserGmailAccount {
  id            String   @id @default(uuid())
  userId        String
  user          AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String?
  googleUserId  String   @default("me")
  refreshToken  String
  scopes        String[]
  connectedAt   DateTime @default(now())
  lastUsedAt    DateTime?
  lastError     String?
  isActive      Boolean  @default(true)

  @@unique([userId])
  @@index([isActive])
}

model AuthRefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model UserProfile {
  id     String  @id @default(uuid())
  userId String  @unique
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String
  location       String?
  phone          String?
  email          String
  linkedin       String?
  github         String?
  portfolio      String?
  resumeFilePath     String?
  languages          String[] @default([])
  summary            String?  @db.Text
  telegramBotToken    String?  // encrypted at rest, never returned to the client
  telegramChatId      String?  // captured server-side via the connect flow; never client-supplied
  telegramUsername    String?
  telegramFirstName   String?
  telegramConnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Short-lived, single-use Telegram connect session.
// Telegram deep-link `start` payloads are limited to 64 chars ([A-Za-z0-9_-]),
// so a self-contained signed JWT (carrying a UUID) does not fit. Instead the
// start payload is a random unguessable nonce that maps to this server-side row;
// expiry + consumedAt give replay/single-use protection equivalent to a signed token.
model TelegramConnectSession {
  id         String    @id @default(uuid())
  nonce      String    @unique // the value embedded in the t.me/...?start=<nonce> deep link
  userId     String
  user       AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String    @default("user_bot") // "user_bot" | "shared_bot"
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model UserTechnology {
  id       String  @id @default(uuid())
  userId   String
  user     AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  category String
  level    String?

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([category])
}

model UserExperience {
  id           String   @id @default(uuid())
  userId       String
  user         AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      String
  title        String
  location     String?
  startDate    String
  endDate      String?
  project      String?
  description  String?  @db.Text
  bullets      String[] @default([])
  technologies String[] @default([])
  sortOrder    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sortOrder])
}

model UserEducation {
  id          String   @id @default(uuid())
  userId      String
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution String
  program     String
  location    String?
  startDate   String?
  endDate     String?
  details     String[] @default([])
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sortOrder])
}

model UserResumeBase {
  id          String           @id @default(uuid())
  userId      String
  user        AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  target      ResumeBaseTarget @default(FULLSTACK)
  targetTitle String?
  content     String           @db.Text
  sourceFilePath String?
  isDefault   Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, target])
}

model UserLinkedInAccount {
  id               String    @id @default(uuid())
  userId           String
  user             AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            String?
  profileUrl       String?
  storageStatePath String
  connectedAt      DateTime  @default(now())
  lastUsedAt       DateTime?
  isActive         Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([isActive])
}

model UserUsageEvent {
  id        String         @id @default(uuid())
  userId    String
  user      AppUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UsageEventType
  amount    Int            @default(1)
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([userId, type, createdAt])
  @@index([createdAt])
}

model Job {
  id            String    @id @default(uuid())
  externalJobId String?
  title         String
  company       String?
  location      String?
  url           String?
  normalizedUrl String?   @unique
  fingerprint   String?   @unique
  postedAt      DateTime?
  description   String
  source        String?
  status        JobStatus @default(NEW)

  resumeVersions   ResumeVersion[]
  coverLetters     CoverLetter[]
  applications     Application[]
  userMatches      UserJobMatch[]
  rejectionRecords RejectionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalJobId])
}

model UserJobMatch {
  id         String        @id @default(uuid())
  userId     String
  user       AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status     UserJobStatus @default(NEW)
  matchScore Int?
  analysis   Json?
  matchedAt  DateTime?
  appliedAt  DateTime?
  ignoredAt  DateTime?
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, jobId])
  @@index([userId, matchScore])
  @@index([userId, appliedAt])
  @@index([userId, status, updatedAt])
}

enum UserJobStatus {
  NEW
  ANALYZED
  SAVED
  REJECTED
  APPLIED
  IGNORED
}

enum JobStatus {
  NEW
  ANALYZED
  SAVED
  REJECTED
  APPLIED
}

enum ApplicationStatus {
  READY
  SUBMITTING
  SUBMITTED
  FAILED
  NEEDS_REVIEW
}

model ResumeVersion {
  id     String  @id @default(uuid())
  jobId  String
  job    Job     @relation(fields: [jobId], references: [id])
  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  content     String
  format      String  @default("markdown")
  filePath    String?
  pdfFilePath String?
  atsScore    Int?
  atsIssues   String[] @default([])
  atsMatchedKeywords String[] @default([])
  atsMissingKeywords String[] @default([])
  atsValidatedAt DateTime?

  applications Application[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CoverLetter {
  id     String  @id @default(uuid())
  jobId  String
  job    Job     @relation(fields: [jobId], references: [id])
  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  content  String
  filePath String?

  applications Application[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Application {
  id              String        @id @default(uuid())
  userId          String
  user            AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id])
  resumeVersionId String
  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id])
  coverLetterId   String?
  coverLetter     CoverLetter?  @relation(fields: [coverLetterId], references: [id])

  status       ApplicationStatus @default(READY)
  submitUrl    String?
  autoSubmit   Boolean           @default(false)
  formSnapshot Json?
  error        String?
  submittedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([userId, jobId])
}

enum EmailEventType {
  NEW_JOB_ALERT
  APPLICATION_RECEIVED
  APPLICATION_VIEWED
  RECRUITER_MESSAGE
  ACTION_REQUIRED
  REJECTION
  POSITIVE_RESPONSE
  OTHER
}

model EmailEvent {
  id             String         @id @default(uuid())
  userId         String
  user           AppUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId String
  gmailThreadId  String?
  type           EmailEventType @default(OTHER)
  source         String?
  subject        String
  from           String?
  snippet        String?
  bodyPreview    String?        @db.Text
  url            String?
  emailTs        DateTime
  labels         String[]       @default([])
  raw            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gmailMessageId])
  @@index([userId, type, emailTs])
  @@index([userId, emailTs])
}

enum AppliedVacancyStatus {
  ATTEMPTED
  APPLIED
  APPLICATION_RECEIVED
  APPLICATION_VIEWED
  RECRUITER_MESSAGE
  ACTION_REQUIRED
  REJECTION
  POSITIVE_RESPONSE
}

model AppliedVacancy {
  id           String               @id @default(uuid())
  userId       String
  user         AppUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint  String
  title        String
  company      String
  status       AppliedVacancyStatus
  source       String
  jobUrl       String?
  emailSubject String?
  emailFrom    String?
  firstSeenAt  DateTime             @default(now())
  lastSeenAt   DateTime             @default(now())
  raw          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId, company, title])
  @@index([userId, status, lastSeenAt])
}

model CompanyPriorityTarget {
  id                String    @id @default(uuid())
  name              String    @unique
  normalizedName    String    @unique
  locationHint      String?
  careerUrl         String?
  priority          Int       @default(50)
  active            Boolean   @default(false)
  sourceHits        Int       @default(0)
  centerHits        Int       @default(0)
  totalJobsFound    Int       @default(0)
  checksCount       Int       @default(0)
  consecutiveNoJobs Int       @default(0)
  lastFoundAt       DateTime?
  lastCheckedAt     DateTime?
  nextCheckAt       DateTime?
  lastSource        String?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active, priority])
  @@index([nextCheckAt])
  @@index([lastFoundAt])
}

// Per-user blacklist of companies whose vacancies are never collected, analyzed,
// or turned into resumes — both in the daily automation and manual searches.
model UserBlacklistedCompany {
  id             String   @id @default(uuid())
  userId         String
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  createdAt      DateTime @default(now())

  @@unique([userId, normalizedName])
  @@index([userId])
}

// ─── PROMPT LEARNING ──────────────────────────────────────────────────────────

enum RejectionReasonType {
  OVERQUALIFIED
  UNDERQUALIFIED
  WRONG_TECH_STACK
  WRONG_SENIORITY
  LOCATION_MISMATCH
  COMPANY_TYPE_MISMATCH
  SALARY_MISMATCH
  NO_RESPONSE
  OTHER
}

enum PromptRuleCategory {
  SKILLS
  SENIORITY
  COMPANY_TYPE
  LOCATION
  GENERAL
}

model RejectionRecord {
  id     String  @id @default(uuid())
  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  jobTitle   String
  company    String
  matchScore Int                 @default(0)
  reason     String?             @db.Text // текст от работодателя или пользователя
  reasonType RejectionReasonType @default(OTHER)
  analysis   Json // снимок GPT-анализа на момент подачи
  jobSnippet String              @db.Text // первые 1000 символов описания вакансии

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, reasonType])
  @@index([jobId])
}

model PromptRule {
  id     String  @id @default(uuid())
  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  rule         String             @db.Text // текст правила (1–2 предложения)
  category     PromptRuleCategory @default(GENERAL)
  confidence   Float              @default(0.5) // 0.0–1.0
  appliedCount Int                @default(0) // сколько раз включался в промт
  hitCount     Int                @default(0) // сколько раз подтверждён позитивным исходом

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, confidence(sort: Desc)])
  @@index([userId, category])
}
